class Prodotto:
  def __init__(self, nome, prezzo, quantita):
    self.nome = nome
    self.prezzo = prezzo
    self.quantita = quantita

  def calcola_valore_totale (self) -> int:
    return self.prezzo * self.quantita

  def descrivi(self):
    # hai istruito l'oggetto a eseguire il calcolo su sé stesso (sui suoi attributi prezzo e quantita) e a incorporare quel risultato nella stringa descrittiva.
    return (f"Il tuo {self.nome} costa {self.prezzo} per solo {self.quantita} pezzi. \n È un cazzo di problema! il valore totale di tutta sta roba è di {self.calcola_valore_totale()}€")

class ProdottoAlimentare(Prodotto):
  def __init__(self, nome, prezzo, quantita, data_di_scadenza):
    super().__init__()

prodotto_a = Prodotto("Pasticcino", 4, 5)
print(prodotto_a.calcola_valore_totale())
print(prodotto_a.descrivi())

"""Analisi del Costruttore della Sottoclasse
La classe figlia è ProdottoAlimentare(Prodotto). Il suo lavoro è gestire i propri parametri unici (data_scadenza) e delegare la gestione dei parametri comuni (nome, prezzo, quantita) al genitore (Prodotto).

1. Definizione del Metodo __init__ (La Raccolta)
Python

def __init__(self, nome, prezzo, quantita, data_scadenza):
    # ...
Cosa fai: Stai raccogliendo tutti i parametri che servono per costruire sia il genitore che il figlio. Questa è l'unica riga in cui compaiono tutti i parametri insieme.

2. La Chiamata a super().__init__(...) (La Delega)
Python

super().__init__(nome, prezzo, quantita)
Cosa succede: La parola chiave super() ti dà accesso alla classe genitore. Chiamando super().__init__(...), stai dicendo a Python:

"Ehi, Prodotto (il genitore), prendi questi tre parametri (nome, prezzo, quantita) e fai il tuo lavoro: inizializza self.nome, self.prezzo e self.quantita come faresti normalmente."

Risposta alla tua domanda: Sì, in questa riga riprendi i parametri che spettano al genitore e li passi al genitore stesso.

3. Inizializzazione Specifica (Il Completamento)
Python

self.data_scadenza = data_scadenza
Cosa succede: Qui la classe figlia fa il suo lavoro specifico. Inizializza l'attributo che non esisteva nel genitore, usando il parametro data_scadenza ricevuto.

Risposta alla tua domanda: Sì, qui crei e salvi il nuovo attributo.
"""

class Automobile:
  def __init__(self, brand, nome) -> None:
    self.brand = brand
    self.nome = nome

class Utilitaria(Automobile):
  def __init__(self, brand, nome, cilindrata, carburante) -> None:
    super().__init__(brand, nome)
    self.cilindrata = cilindrata
    self.carburante = carburante

  def andare (self):
    return (f"Finchè la macchina va, lasciala andare")

auto_1 = Utilitaria("Toyota", "Yaris", 1500, "Benzina")
auto_2 = Automobile("Fiat", "Panda")

print(f"{auto_1.brand} \n{auto_1.nome} \nQuesta è davvero un'ottima macchina. \n{auto_1.andare()}")
print(f"{auto_2.brand}\n{auto_2.nome} \nQuesta invece è proprio nammerda")

