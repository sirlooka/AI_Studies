"""### CICLO FOR

Il ciclo for itera direttamente su un oggetto iterabile
"""

lista_spesa = ["tofu", "riso basmati", "yogurt greco", "latte di soia"]
print("La mia lista della spesa: ")

for item in lista_spesa: # voglio iterare ogni elemento, chiamato come una variabile dal nome "item", all'interno della lista lista_spesa per un numero di volte pari agli elementi all'interno della lista
  print(f"- {item}")

