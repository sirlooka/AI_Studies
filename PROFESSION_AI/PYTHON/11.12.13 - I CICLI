### CICLO WHILE

Il ciclo while ci permette di eseguire un codice in modo ciclico (iterare) finché l'espressione booleana non viene verificata
"""

msg = ""

while msg != "Esci": # finché il messaggio è diverso da "Esci" allora fai quanto segue
  msg = input("Scrivi il messaggio: ") # stampa l'input dell'utente

print("Ciclo terminato")

"""i cicli WHILE vengono spesso combinati con una variabile contatore, spesso denominata "i"
"""

# facciamo un programma che conta fino a un numero deciso dall'utente

n = int(input("Fino a che numero vuoi contare bro? "))
i = 0

while i <= n:
  print(i) # finisse qui il codice, il programma conterebbe infinito perché non ci sono progressioni stabilite e rimarrebbe in loop sul primo numero utile "0"
  i += 1 # con questo, prende i e somma 1 a i, dando un massimale al conteggio fino al numero stabilito dall'utente

"""Possiamo anche dare delle istruzioni condizionali al ciclo"""

n = int(input("Fino a che numero vuoi contare bro? "))
i = 0

while i < n:
  if i%2 == 0:
    print(f"{i} è pari")
  else:
    print(f"{i} è dispari")
  i+=1

